; fib.sasm — Fibonacci(8) iterative for SUB-CPU
; Copyright (C) 2026 Subho
; SPDX-License-Identifier: GPL-3.0-or-later

LDI R0, 0        ; a = 0
LDI R1, 1        ; b = 1
LDI R3, 8        ; counter = 8
LDI R4, 0        ; temp

loop:
  ADD R4, R0, R1  ; temp = a + b
  MOV R0, R1      ; a = b
  MOV R1, R4      ; b = temp
  LDI R5, 1
  SUB R3, R3, R5  ; counter--
  JNZ loop        ; loop if counter != 0

MOV R2, R0       ; result in R2 (should be 21)
HLT
