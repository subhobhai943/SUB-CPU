; fib.sasm — Fibonacci(10) on SUB64
; Result will be in X2
; Copyright (C) 2026 Subho — GPL v3

  LDIM  X0, 0        ; a = 0
  LDIM  X1, 1        ; b = 1
  LDIM  X23, 10      ; loop counter (X23 used by LOOP)

loop:
  ADD   X4, X0, X1  ; temp = a + b
  MOV   X0, X1      ; a = b
  MOV   X1, X4      ; b = temp
  LOOP  loop        ; X23--; if X23 != 0, branch

  MOV   X2, X0      ; result in X2
  HLT
