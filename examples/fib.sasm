; fib.sasm — Fibonacci(10) on SUB64
; Result will be in X4 (a0 / return value per SUB64 ABI)
; Copyright (C) 2026 Subho — GPL v3

  LDIM  X8, 0        ; a = 0 (t0)
  LDIM  X9, 1        ; b = 1 (t1)
  LDIM  X23, 10      ; loop counter (X23 hardware loop register)

loop:
  ADD   X10, X8, X9  ; temp = a + b
  MOV   X8, X9       ; a = b
  MOV   X9, X10      ; b = temp
  LOOP  loop         ; X23--; if X23 != 0, branch to loop

  MOV   X4, X8       ; result in X4 (Fibonacci(10) = 55)
  HLT
