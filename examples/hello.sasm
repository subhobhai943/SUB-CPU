; hello.sasm — SUB64 Assembly Example
; Loads two values, adds them, stores result
; Copyright (C) 2026 Subho — GPL v3

  LDIM  X4, 100       ; X4 = 100  (48-bit immediate)
  LDIM  X5, 200       ; X5 = 200
  ADD   X6, X4, X5   ; X6 = 300
  CMP   X6, X4       ; set flags
  MOVZ  X7, X6       ; X7 = X6 only if Z flag set
  HLT
